---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" noindex showQuote={false}>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Error 404</p>
      <h1 class="h2">We couldn't find that page.</h1>
      <p>The page may have moved. Try our machine catalog, or get in touch and we'll help you find what you need.</p>
      <div class="split-actions">
        <a class="btn btn-primary" href="/machines/">Browse machines<Icon name="arrow-right" class="ico-nudge" /></a>
        <a class="link-arrow" href="/">Back to home<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</Base>
